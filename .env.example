# Names only. Real values go in .env locally (git-ignored) and Secret Manager in production.
# Model strings come from the hackathon builder resources.
GEMINI_API_KEY=
MODEL_HYDROGEN=
MODEL_ARGON=
MODEL_CARBON=
MODEL_NEON=
# Decisions API model id (e.g. gemini-decision-1) and Managed Agent id
# (e.g. antigravity-preview-09-2026); not chat model names
MODEL_DECISIONS=
MANAGED_AGENT=
GCP_PROJECT=
GCP_REGION=us-central1
GCS_BUCKET=
FIRESTORE_DATABASE=(default)
ACCESS_CODE=
# Set at deploy to the git short sha; "dev" when unset
APP_VERSION=
