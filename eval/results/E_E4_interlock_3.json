  "explanations": [
   {
    "attribute": "arrangement",
    "likely_right_file": "bhel/Part1.pdf",
    "likely_right_page": 44,
    "why": "Both 1W+1S and 2X100% actually mean the same thing (two 100%-capacity pumps, with one working and one standby), so there is no real physical contradiction. However, Part1.pdf page 44 (supported by Part4.pdf page 61) is more explicit about the operating philosophy and directly matches the proposed change's wording.",
    "consequence": "If 2X100% is misread as two pumps running at the same time instead of one working and one standby, power systems, piping, and controls might be oversized or set up to run multiple pumps at once, causing sump dry-running or pipe overpressure."
   }
